# Django 基础配置
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_READ_DOT_ENV_FILE=True
# SECURITY WARNING: Keep the secret key used in production secret!
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_STRING
# In production, set this to your actual domain(s), comma-separated
# Example: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOW_ALL_ORIGINS=True
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# 数据库配置
# ------------------------------------------------------------------------------
# SECURITY WARNING: Use strong passwords in production
MYSQL_DATABASE=django_db
MYSQL_USER=django_user
MYSQL_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=21600

# 数据库连接池配置
# ------------------------------------------------------------------------------
MYSQL_POOL_MAX_SIZE=20
MYSQL_POOL_MIN_SIZE=5
MYSQL_POOL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30
MYSQL_POOL_RECYCLE=3600

# Celery 配置
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0

# 安全配置
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# JWT 配置
# ------------------------------------------------------------------------------
# SECURITY WARNING: Generate strong, unique values for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
DJANGO_RSA_PASSWORD=CHANGE_THIS_TO_SECURE_RANDOM_STRING
DJANGO_BASE64_SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING
JWT_EXPIRATION_DELTA=100
JWT_AUTH_HEADER_PREFIX=Bearer
TOKEN_LIFETIME=3600
TOKEN_DETECT=1800
TOKEN_RENEW_PERIOD=3600
ACCESS_TOKEN_LIFETIME=150
REFRESH_TOKEN_LIFETIME=1

# API 限流配置
# ------------------------------------------------------------------------------
DJANGO_THROTTLE_ANON=100/day
DJANGO_THROTTLE_USER=1000/day

# 阿里云短信配置
# ------------------------------------------------------------------------------
# SECURITY WARNING: Use your actual Aliyun credentials in production
ALI_SMS_ACCESS_KEY_ID=CHANGE_THIS_TO_YOUR_ACCESS_KEY
ALI_SMS_ACCESS_KEY_SECRET=CHANGE_THIS_TO_YOUR_SECRET_KEY
ALI_SMS_REGION_ID=cn-hangzhou
ALI_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALI_SMS_SIGN_NAME=your_sms_sign_name
ALI_SMS_CODE_TEMPLATE=your_template_code
SMS_CODE_EXPIRE=600
SMS_CODE_LENGTH=6

# 验证码配置
# ------------------------------------------------------------------------------
LOGIN_CODE_TYPE=ARITHMETIC
LOGIN_CODE_LENGTH=4
LOGIN_CODE_WIDTH=120
LOGIN_CODE_HEIGHT=40
LOGIN_CODE_FONT_SIZE=20
EXPIRATION_DELTA=2

# 用户配置
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
DJANGO_PAGE_SIZE=10
USER_CACHE_IDLE_TIME=3600
SINGLE_LOGIN=True
# SECURITY WARNING: Always set a secure default password in production
START_PASSWORD=ChangeMe123!

# 文件上传配置
# ------------------------------------------------------------------------------
FILE_UPLOAD_PERMISSIONS=0o666

# 开发工具配置
# ------------------------------------------------------------------------------
# 如果使用VS Code进行开发，可以设置以下环境变量
PYTHONPATH=${workspaceFolder}
DJANGO_SETTINGS_MODULE=config.settings.local

# 多租户配置 / Multi-Tenancy Configuration
# ------------------------------------------------------------------------------
# 是否启用多租户功能 / Enable multi-tenancy
# 设置为False可关闭多租户，系统作为单租户运行 / Set to False to disable multi-tenancy
MULTI_TENANT_ENABLED=True
# 是否必须识别租户 / Whether tenant identification is required
MULTI_TENANT_REQUIRED=False
# 默认租户代码 / Default tenant code
DEFAULT_TENANT_CODE=default
# 租户默认最大用户数 / Default maximum users per tenant
DEFAULT_MAX_USERS=100

# RBAC权限管理配置 / RBAC Permission Management Configuration
# ------------------------------------------------------------------------------
# 是否启用RBAC权限管理 / Enable RBAC permission management
RBAC_ENABLED=True
# 是否启用数据范围控制 / Enable data scope control
DATA_SCOPE_ENABLED=True
# 默认数据范围 / Default data scope (all/dept_and_sub/dept/self)
DEFAULT_DATA_SCOPE=self
# 权限缓存时间（秒）/ Permission cache time (seconds)
PERMISSION_CACHE_TIMEOUT=3600

# 菜单和按钮权限配置 / Menu and Button Permissions Configuration
# ------------------------------------------------------------------------------
# 是否启用菜单权限 / Enable menu permissions
MENU_PERMISSION_ENABLED=True
# 是否启用按钮权限 / Enable button permissions
BUTTON_PERMISSION_ENABLED=True

# 租户隔离配置 / Tenant Isolation Configuration
# ------------------------------------------------------------------------------
# 是否允许跨租户访问（仅超级管理员）/ Allow cross-tenant access (superuser only)
ALLOW_CROSS_TENANT_ACCESS=False
# 租户会话隔离 / Tenant session isolation
TENANT_SESSION_ISOLATION=True

# 租户配额配置 / Tenant Quotas Configuration
# ------------------------------------------------------------------------------
# 每个租户最大角色数 / Maximum roles per tenant
MAX_ROLES_PER_TENANT=50
# 每个租户最大菜单数 / Maximum menus per tenant
MAX_MENUS_PER_TENANT=200
# 每个租户最大权限数 / Maximum permissions per tenant
MAX_PERMISSIONS_PER_TENANT=500
# 每个用户最大角色数 / Maximum roles per user
MAX_ROLES_PER_USER=10

# 日志配置 / Logging Configuration
# ------------------------------------------------------------------------------
# 是否记录租户操作 / Log tenant operations
LOG_TENANT_OPERATIONS=True
# 是否记录权限检查失败 / Log permission check failures
LOG_PERMISSION_FAILURES=True

# 性能优化配置 / Performance Optimization Configuration
# ------------------------------------------------------------------------------
# 是否启用租户缓存 / Enable tenant caching
TENANT_CACHE_ENABLED=True
# 租户缓存时间（秒）/ Tenant cache time (seconds)
TENANT_CACHE_TIMEOUT=3600
# 是否启用权限缓存 / Enable permission caching
PERMISSION_CACHE_ENABLED=True

# 租户创建限制 / Tenant Creation Restrictions
# ------------------------------------------------------------------------------
# 是否允许自动创建租户 / Allow automatic tenant creation
ALLOW_AUTO_TENANT_CREATION=False

# 用户类型配置 / User Type Configuration
# ------------------------------------------------------------------------------
# 用户职位类型（逗号分隔）/ User position types (comma-separated)
USER_TYPE=student,teacher,admin,manager 